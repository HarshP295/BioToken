# Copy to .env and fill in. Used by Hardhat scripts and by the AI service (ai/api.py).
# On Render these are set on the biotoken-api service (see render.yaml, docs/DEPLOYMENT.md).

# ── Polygon Amoy ──
AMOY_RPC_URL=https://polygon-amoy.drpc.org
# Deployer/admin key: deploys contracts, holds DEFAULT_ADMIN_ROLE, grants roles from the API
DEPLOYER_PRIVATE_KEY=
# BioToken address (set by scripts/deploy.js; the API falls back to deployments/amoy.json)
VITE_CONTRACT_ADDRESS=

# ── AI service ──
# Signs GENUINE verdicts; its address gets AI_ORACLE_ROLE at deploy time
AI_ORACLE_PRIVATE_KEY=
# X-Admin-Token for /admin/* endpoints
ADMIN_API_TOKEN=
# true: the role a user picks is granted at once; false: an admin approves each request
ROLE_AUTO_APPROVE=true
# Comma-separated browser origins allowed to call the API (* for local development)
CORS_ORIGINS=*
MONGODB_URI=mongodb://localhost:27017

# ── Pinata (IPFS) ──
PINATA_API_KEY=
PINATA_SECRET_KEY=
