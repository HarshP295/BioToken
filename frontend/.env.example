# Copy to frontend/.env for local development. Vite reads these at build time.
# On Render they are set on the biotoken-web static site (see render.yaml).
VITE_PRIVY_APP_ID=
VITE_PIMLICO_API_KEY=
VITE_PIMLICO_POLICY_ID=
# Full URL of the AI service (local) — or VITE_AI_API_HOST=<host> to use https://<host>
VITE_AI_API_URL=http://localhost:8000
VITE_AMOY_RPC_URL=https://polygon-amoy.drpc.org
# Optional: defaults to the address in deployments/amoy.json
VITE_CONTRACT_ADDRESS=
